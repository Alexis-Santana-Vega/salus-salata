# Copia este archivo como .env y cambia las contraseñas. .env nunca se sube a git.

# --- Firebird ---
# Contraseña de SYSDBA (administrador del servidor). Solo para mantenimiento.
FIREBIRD_ROOT_PASSWORD=cambia-esta-contrasena-root
# Usuario con el que se conecta la aplicación.
FIREBIRD_USER=SALUS_APP
FIREBIRD_PASSWORD=cambia-esta-contrasena-app
# Puerto publicado en 127.0.0.1 (solo desarrollo).
FIREBIRD_PORT=3050
# Alias definido en infra/firebird/databases.conf (la app nunca usa la ruta real).
FIREBIRD_DB_ALIAS=salus
# Host de Firebird para "go run" local. En docker compose se usa "db".
FIREBIRD_HOST=127.0.0.1

# --- Backend ---
# development | production
APP_ENV=development
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
# Documentación Scalar en /docs (prohibido en producción)
DOCS_ENABLED=true
# Orígenes permitidos para CORS (solo desarrollo; en producción el front va por el mismo origen)
CORS_ORIGINS=http://localhost:3000

# --- Autenticación ---
# Secreto para firmar los tokens: 64 caracteres aleatorios, distinto en cada servidor.
JWT_SECRET=cambia-esto-por-64-caracteres-aleatorios-cambia-esto-por-64-caracteres
# Vida del token de acceso (1m–1h) y de la sesión renovable (1h–720h).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Primer Sysadmin: se crea solo si no existe ninguno. Debe cambiar la
# contraseña en su primer acceso. Después puedes borrar INITIAL_ADMIN_PASSWORD.
INITIAL_ADMIN_USUARIO=admin
INITIAL_ADMIN_CORREO=admin@salus.local
INITIAL_ADMIN_NOMBRE=Administrador del sistema
INITIAL_ADMIN_PASSWORD=cambia-esta-contrasena-inicial
