# Entorno de PRODUCCIÓN. Copia este archivo como .env.produccion y pon valores
# propios: contraseñas y JWT_SECRET distintos a los de pruebas. Nunca se sube a git.
# Se usa con: bash scripts/entorno.sh produccion <comando>

# --- Firebird (base productiva, en su propio volumen) ---
FIREBIRD_ROOT_PASSWORD=cambia-esta-contrasena-root-produccion
FIREBIRD_USER=SALUS_APP
FIREBIRD_PASSWORD=cambia-esta-contrasena-app-produccion
FIREBIRD_DB_ALIAS=salus

# --- Backend ---
APP_ENV=production
LOG_LEVEL=info
DOCS_ENABLED=false
CORS_ORIGINS=

# --- Autenticación ---
JWT_SECRET=cambia-esto-por-64-caracteres-aleatorios-distintos-a-los-de-pruebas
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
INITIAL_ADMIN_USUARIO=admin
INITIAL_ADMIN_CORREO=admin@salus.local
INITIAL_ADMIN_NOMBRE=Administrador del sistema
INITIAL_ADMIN_PASSWORD=cambia-esta-contrasena-inicial-produccion

# --- Red y puertos (distintos a pruebas para poder correr ambos a la vez) ---
SALUS_SUBNET=172.29.0.0/24
NGINX_IP=172.29.0.10
# En esta máquina: 127.0.0.1 con 8088/8443. En el servidor: BIND_IP=0.0.0.0, 80 y 443.
BIND_IP=127.0.0.1
HTTP_PORT=8088
HTTPS_PORT=8443
